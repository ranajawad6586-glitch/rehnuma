# RehnumaRent — environment template. Copy to .env for local non-Docker runs.
# Docker Compose sets these directly; you only need this file outside Docker.

# Postgres + PostGIS (async driver)
DATABASE_URL=postgresql+asyncpg://rehnuma:rehnuma@localhost:5432/rehnuma

# Redis (OTP / notification jobs from M2 onward)
REDIS_URL=redis://localhost:6379/0

# Seed the Bahria grid on startup if the plots table is empty
AUTO_SEED=false

# dev | prod — prod disables the dev OTP echo in API responses
ENV=dev

# Secrets — MUST be set to strong random values in prod.
# SECRET_KEY signs session tokens; HASH_PEPPER keys the phone/CNIC HMAC hashes
# (rotating HASH_PEPPER invalidates every stored hash).
SECRET_KEY=dev-insecure-change-me
HASH_PEPPER=dev-insecure-pepper-change-me
# Derives the Fernet key that encrypts the raw phone at rest. Rotating it makes existing
# encrypted phones undecryptable.
PHONE_ENCRYPTION_SECRET=dev-insecure-phone-key-change-me

# WhatsApp Business API (OTP delivery). If unset, dev falls back to a console sender
# and /auth/otp/request returns the code in `dev_code` (dev only, server-side keys only).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# Apify listing import (server-side only). APIFY_ACTOR_ID is a scraper Actor from the Apify
# store (e.g. a Zameen/property scraper, "username~actor-name"); APIFY_RUN_INPUT_JSON is that
# actor's input JSON (its schema is actor-specific). Then run:
#   docker compose run --rm api python -m app.jobs.apify_import
# APIFY_TOKEN=
# APIFY_ACTOR_ID=
# APIFY_RUN_INPUT_JSON={"startUrls":[{"url":"https://www.zameen.com/Rentals/Rawalpindi-41-1.html"}],"maxItems":50}

# --- Reserved for later milestones (server-side ONLY, never sent to client) ---
# LLM fallback chain: Groq -> Gemini -> OpenRouter -> Anthropic Haiku (M4)
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
